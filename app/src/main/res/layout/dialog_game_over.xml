<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="#D9FFFFFF"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Glowing Header Icon Badge -->
        <FrameLayout
            android:id="@+id/dialogIconContainer"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/icon_circle_container"
            android:backgroundTint="#FEF3C7">

            <ImageView
                android:id="@+id/dialogHeaderIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:contentDescription="Trophy Icon"
                android:src="@drawable/ic_gold_medal" />
        </FrameLayout>

        <!-- Match Result Title -->
        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-bold"
            android:text="MATCH OVER 🏆"
            android:textColor="@color/gray_900"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Highlight Result Banner Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#80F8FAFC"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/dialogResultMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:padding="16dp"
                android:text="Player 1 (O) Has Won!"
                android:textColor="@color/gray_900"
                android:textSize="16sp" />
        </androidx.cardview.widget.CardView>

        <!-- Buttons Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogPlayAgain"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:backgroundTint="@color/primary_blue"
                android:fontFamily="sans-serif-bold"
                android:text="PLAY AGAIN 🔄"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogExit"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:fontFamily="sans-serif-medium"
                android:text="EXIT MATCH"
                android:textColor="@color/gray_800"
                android:textSize="14sp"
                app:cornerRadius="14dp"
                app:strokeColor="@color/gray_400" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>