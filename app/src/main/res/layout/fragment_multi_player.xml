<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.multiplyer.MultiPlayerFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/gameModeGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- First Row -->

            <Button
                android:id="@+id/multiClassicModeBtn"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_margin="8dp"
                android:backgroundTint="@color/accent_color"
                android:elevation="4dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp"
                android:stateListAnimator="@null"
                android:text="@string/classic_mode"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:translationZ="2dp"
                app:cornerRadius="20dp"
                app:icon="@android:drawable/ic_dialog_dialer"
                app:iconGravity="textTop"
                app:iconPadding="12dp"
                app:iconSize="40dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/multiOnlineModeBtn"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5" />

            <Button
                android:id="@+id/multiOnlineModeBtn"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_margin="8dp"
                android:backgroundTint="@color/primary_color"
                android:elevation="4dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp"
                android:stateListAnimator="@null"
                android:text="@string/play_online"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:translationZ="2dp"
                app:cornerRadius="20dp"
                app:icon="@drawable/baseline_group_24"
                app:iconGravity="textTop"
                app:iconPadding="12dp"
                app:iconSize="40dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toEndOf="@+id/multiClassicModeBtn"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5" />

            <!-- Second Row -->

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/quickActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/multiLeaderboardAiLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/quick_action_background"
                android:gravity="center"
                android:padding="12dp"
                android:text="AI Leaderboard"
                android:textColor="@color/primary_color"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/multiLeaderboardOfflineLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/quick_action_background"
                android:gravity="center"
                android:padding="12dp"
                android:text="Offline Leaderboard"
                android:textColor="@color/primary_color"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/multiLeaderboardOnlineLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/quick_action_background"
                android:gravity="center"
                android:padding="12dp"
                android:text="Online Leaderboard"
                android:textColor="@color/primary_color"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/multiLeaderboardCoinsLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/quick_action_background"
                android:gravity="center"
                android:padding="12dp"
                android:text="Coins Leaderboard"
                android:textColor="@color/primary_color"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>