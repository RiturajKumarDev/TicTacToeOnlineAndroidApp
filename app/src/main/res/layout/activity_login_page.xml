<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_gradient_background"
    tools:context=".ui.auth.LoginPage">

    <!-- Decorative translucent ambient background circles -->
    <View
        android:id="@+id/decorativeCircle1"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:alpha="0.12"
        android:background="@drawable/circle_white_transparent"
        android:translationX="-60dp"
        android:translationY="-90dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/decorativeCircle2"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:alpha="0.12"
        android:background="@drawable/circle_white_transparent"
        android:translationX="120dp"
        android:translationY="220dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Background Floating X Symbol -->
    <ImageView
        android:id="@+id/floatingX"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="32dp"
        android:alpha="0.2"
        android:contentDescription="Floating X"
        android:src="@drawable/x"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Background Floating O Symbol -->
    <ImageView
        android:id="@+id/floatingO"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="120dp"
        android:alpha="0.2"
        android:contentDescription="Floating O"
        android:src="@drawable/o"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="28dp">

            <!-- Logo Container with Glowing Aura Ring -->
            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center">

                <View
                    android:id="@+id/splashGlowRing"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:alpha="0.5"
                    android:background="@drawable/splash_glow_ring" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/logoCard"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:translationZ="12dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="14dp">

                    <ImageView
                        android:id="@+id/imageView9"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Game Logo"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/game_app_logo_cir" />
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- App Title -->
            <TextView
                android:id="@+id/appSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:shadowColor="#60000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text="@string/app_name"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Subtitle Pill Badge -->
            <TextView
                android:id="@+id/appTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/icon_circle_container"
                android:backgroundTint="#25FFFFFF"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="⚡ Ultimate Realtime Gaming Arena"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <!-- Feature Badges Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/icon_circle_container"
                    android:backgroundTint="#20FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:text="🌐 Online"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/icon_circle_container"
                    android:backgroundTint="#20FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:text="🤖 Pro AI"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/icon_circle_container"
                    android:backgroundTint="#20FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:text="🏆 Ranks"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Glassmorphic Login Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/loginActionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="#20FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Ready to Play? 🎮"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Sign in to save your stats, coins &amp; climb global leaderboards!"
                        android:textColor="#DDFFFFFF"
                        android:textSize="13sp" />

                    <!-- Google Sign-In Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loginBtn"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="@android:color/white"
                        android:elevation="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Sign in with Google"
                        android:textAllCaps="false"
                        android:textColor="#111827"
                        android:textSize="16sp"
                        app:cornerRadius="28dp"
                        app:icon="@drawable/ic_google_g"
                        app:iconGravity="textStart"
                        app:iconPadding="14dp"
                        app:iconSize="24dp"
                        app:iconTint="@null" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Terms & Privacy Text -->
            <TextView
                android:id="@+id/termsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/by_continuing_you_agree_to_our_nterms_of_service_and_privacy_policy"
                android:textColor="#A0FFFFFF"
                android:textSize="11sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>