<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardView6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Avatar Container with Online Indicator -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp">

            <androidx.cardview.widget.CardView
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="2dp">

                <ImageView
                    android:id="@+id/onlineUserProfileImgList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="User Avatar"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/user" />
            </androidx.cardview.widget.CardView>

            <!-- Status Green LED Badge -->
            <ImageView
                android:id="@+id/greenLed"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:elevation="6dp"
                android:src="@drawable/ic_online_badge"
                android:translationZ="6dp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- User Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/onlineUserNameList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/gray_900"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Player Name" />

            <TextView
                android:id="@+id/onlineUserStatusSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/gray_600"
                android:textSize="12sp"
                tools:text="Online &amp; Ready" />
        </LinearLayout>

        <!-- Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/userCardPlayBtn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="@color/primary_blue"
            android:fontFamily="sans-serif-bold"
            android:paddingHorizontal="16dp"
            android:text="CHALLENGE ⚔️"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>