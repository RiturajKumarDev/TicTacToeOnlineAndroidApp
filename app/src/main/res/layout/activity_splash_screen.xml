<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient_background"
    tools:context=".SplashScreen">

    <!-- Ambient Rotating Background Circle (Top-Left) -->
    <View
        android:id="@+id/splashCircle1"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:alpha="0.12"
        android:background="@drawable/circle_white_transparent"
        android:translationX="-60dp"
        android:translationY="-60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Ambient Rotating Background Circle (Bottom-Right) -->
    <View
        android:id="@+id/splashCircle2"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:alpha="0.12"
        android:background="@drawable/circle_white_transparent"
        android:translationX="80dp"
        android:translationY="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Floating Background X Symbol (Top-Right) -->
    <ImageView
        android:id="@+id/floatingX"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="32dp"
        android:alpha="0.3"
        android:contentDescription="Floating X"
        android:src="@drawable/x"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Floating Background O Symbol (Bottom-Left) -->
    <ImageView
        android:id="@+id/floatingO"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="120dp"
        android:alpha="0.3"
        android:contentDescription="Floating O"
        android:src="@drawable/o"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Main Content Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo Container with Glowing Aura Ring -->
        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center">

            <!-- Glowing Pulse Aura Ring (Positioned Behind Logo) -->
            <View
                android:id="@+id/splashGlowRing"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:alpha="0.5"
                android:background="@drawable/splash_glow_ring" />

            <!-- Circular App Logo Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/splashLogoCard"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:translationZ="16dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="60dp"
                app:cardElevation="16dp">

                <ImageView
                    android:id="@+id/imageView7"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Game Logo"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/game_app_logo_cir" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Title & Subtitle Container -->
        <LinearLayout
            android:id="@+id/titleContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView26"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:shadowColor="#60000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text="@string/app_name"
                android:textColor="@android:color/white"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:text="Play Online, Challenge AI &amp; Win Rewards"
                android:textColor="#EEFFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="60dp" />

        <!-- Progress Indicator Container -->
        <LinearLayout
            android:id="@+id/progressContainer"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/preparing_game"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:indeterminate="true"
                android:progressBackgroundTint="#4DFFFFFF"
                android:progressTint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif"
                android:text="@string/version_1_0_0"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>