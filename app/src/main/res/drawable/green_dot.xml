<!-- res/drawable/green_glow_dot.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="24dp"
                android:height="24dp" />
            <solid android:color="#33FF00EE" />  <!-- Semi‑transparent bright green glow -->
        </shape>
    </item>

    <!-- Middle glow -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="16dp"
                android:height="16dp" />
            <solid android:color="#77FF00CC" />
        </shape>
    </item>

    <!-- Core bright dot -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="10dp"
                android:height="10dp" />
            <solid android:color="#FF00FF00" />  <!-- Pure bright green -->
        </shape>
    </item>
</layer-list>